{
  "manifest_version": 3,
  "name": "Iconly Select All",
  "version": "1.0.0",
  "description": "web.iconly.pro에서 아이콘 전체 선택 / 선택 해제 (Export는 Iconly 기능 사용)",
  "action": {
    "default_title": "Iconly Select All"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://web.iconly.pro/*"],
  "content_scripts": [
    {
      "matches": ["https://web.iconly.pro/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
