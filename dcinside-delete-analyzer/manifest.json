{
  "manifest_version": 3,
  "name": "DCInside 게시글·댓글 삭제 도구",
  "version": "2.2.1",
  "description": "갤로그 게시글/댓글 페이지에서 본인 항목을 선택·테스트·전체 순차 삭제합니다. 사이트의 원래 X 버튼을 사용합니다.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://gallog.dcinside.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DCInside 게시글·댓글 삭제 도구",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gallog.dcinside.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": [
        "https://gallog.dcinside.com/*"
      ]
    }
  ]
}
